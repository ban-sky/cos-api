{
    "name": "lonely-starry/cos-api",
    "description": "Random Tencent COS wallpaper service: an HTML page and a redirect API.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "qcloud/cos-sdk-v5": "^2.6"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "lint": [
            "@php -l index.php",
            "@php -l api/index.php",
            "@php -l lib/bootstrap.php",
            "@php -l lib/wallpaper.php",
            "@php -l tests/run.php",
            "@php -l tools/build.php"
        ],
        "test": "@php tests/run.php",
        "check": [
            "@lint",
            "@test"
        ],
        "build": "@php tools/build.php"
    }
}
